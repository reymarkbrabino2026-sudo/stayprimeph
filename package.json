    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "security:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "security:rotate-seeded-passwords": "node scripts/rotate-seeded-passwords.mjs"
  },
