{
  "name": "stayprimeph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:check": "node scripts/check-env.mjs development",
    "prod:check": "node scripts/check-env.mjs production",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
