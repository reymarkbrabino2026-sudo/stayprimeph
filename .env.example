# Shared secure baseline. Do not commit real values.
# Copy .env.development.example for local work, or set production values in your hosting provider's secret manager.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"
POSTGRES_URL_NON_POOLING=""
NEXT_PUBLIC_APP_URL="https://your-domain.example"
API_CORS_ALLOWED_ORIGINS=""
AUTH_SECRET="generate-at-least-32-random-characters"
PERSISTENCE_DRIVER="prisma"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_VERCEL_ANALYTICS="disabled"
RESEND_API_KEY=""
EMAIL_FROM=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
CRON_SECRET=""
RETENTION_CRON_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
PHOTO_BLOB_READ_WRITE_TOKEN=""
BLOB_READ_WRITE_TOKEN=""
JSON_STORE_BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Optional / operational variables (not needed for a normal app run) ---
# Alternate Postgres connection strings some providers inject (Prisma/Vercel/Supabase).
POSTGRES_PRISMA_URL=""
# Build- and test-phase flags. Set automatically by build/E2E tooling — leave unset locally.
# STAYPRIMEPH_BUILD_PHASE="1"   # set during sanitized production builds
# STAYPRIMEPH_E2E="1"           # set when running Playwright E2E against a test server
# PRISMA_MIGRATE_DEPLOY="1"     # opt in to `prisma migrate deploy` during the Vercel build

# --- One-time operator CLI scripts (export in your shell, do not commit real values) ---
# `npm run security:bootstrap-admin` (see docs/admin-bootstrap.md):
# BOOTSTRAP_ADMIN_EMAIL="admin@your-domain.com"
# BOOTSTRAP_ADMIN_PASSWORD="use-a-unique-16-plus-character-password"
# BOOTSTRAP_ADMIN_NAME="Admin Name"
# BOOTSTRAP_ADMIN_CONFIRM="bootstrap-admin-once"
# DRY_RUN="1"
# `npm run security:rotate-seeded-passwords`:
# ROTATE_ADMIN_EMAIL="admin@your-domain.com"
# ROTATE_ADMIN_PASSWORD="use-a-unique-16-plus-character-password"
# `npm run test:rls` (Supabase RLS checks):
# RLS_TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# ALLOW_RLS_TEST_ON_CURRENT_DB="1"
